{
  "name": "crawlora/tiktok-mobile",
  "description": "Crawlora TikTok Mobile API client with 63 endpoints for mobile feed, search, video, creator, music, LIVE, and place endpoints",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "tiktok-mobile",
    "tiktok-mobile-api",
    "tiktok-mobile-scraper",
    "tiktok-mobile-data",
    "tiktok-mobile-mobile-feed",
    "tiktok-mobile-search",
    "tiktok-mobile-video",
    "tiktok-mobile-creator",
    "tiktok-mobile-music",
    "tiktok-mobile-live",
    "tiktok-mobile-place-endpoints"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
