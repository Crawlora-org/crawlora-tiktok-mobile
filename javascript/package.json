{
  "name": "@crawlora-org/tiktok-mobile",
  "version": "0.1.0",
  "description": "Crawlora TikTok Mobile API client with 63 endpoints for mobile feed, search, video, creator, music, LIVE, and place endpoints",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=tiktok-mobile-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-tiktok-mobile/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "tiktok-mobile", "tiktok-mobile-api", "tiktok-mobile-scraper", "tiktok-mobile-data", "tiktok-mobile-mobile-feed", "tiktok-mobile-search", "tiktok-mobile-video", "tiktok-mobile-creator", "tiktok-mobile-music", "tiktok-mobile-live", "tiktok-mobile-place-endpoints"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-tiktok-mobile",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
